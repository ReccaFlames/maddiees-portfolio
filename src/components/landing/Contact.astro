---
    import { Icon } from "astro-icon/components";
---

<section class="flex flex-col px-8">
    <div class="flex flex-col justify-center items-center text-center border-b border-neutral-900 py-8">
        <div class="w-3/4">
            <h2 class="text-4xl pb-4">Let's get in touch!</h2>
            <p>
                I am fully stocked with creative energy, technical skills, and a strong cup of coffee. Whether you have
                a
                project in mind, a collaborative idea, or just want to chat about art and design - I’d love to hear from
                you.
            </p>
        </div>
    </div>
    <div class="flex flex-row w-full py-8">
        <div class="flex flex-col flex-1">
            <h4 class="text-lg">Email</h4>
            <p class="text-base font-thin text-neutral-500">magdalena.skotnicka@gmail.com</p>
        </div>
        <div class="flex flex-col flex-1">
            <h4 class="text-lg">Instagram</h4>
            <p class="text-base font-thin text-neutral-500">@ma.ddiee.s</p>
        </div>
    </div>
    <div>
        <form id="contactForm" class="space-y-5" onsubmit="return false;">
            <!-- Email Input -->
            <div>
                <label for="email" class="block text-xs uppercase tracking-wider font-semibold text-neutral-600 mb-2">
                    Email
                </label>
                <input type="email" id="email" name="email" required placeholder="your@email.com"
                    class="w-full px-2 py-3 border-b border-neutral-900 bg-white text-neutral-900 placeholder:text-neutral-400 focus:outline-none focus:ring-2 focus:ring-neutral-900 focus:border-transparent transition-all text-sm" />
            </div>

            <!-- Message Input -->
            <div>
                <label for="message" class="block text-xs uppercase tracking-wider font-semibold text-neutral-600 mb-2">
                    Message
                </label>
                <textarea id="message" name="message" rows="4" required placeholder="What do you want to talk about?"
                    class="w-full px-2 py-3 border-b border-neutral-900 bg-white text-neutral-900 placeholder:text-neutral-400 focus:outline-none focus:ring-2 focus:ring-neutral-900 focus:border-transparent transition-all text-sm resize-none"></textarea>
            </div>

            <!-- Send Button -->
            <button type="submit"
                class="w-full py-3.5 px-6 bg-neutral-900 hover:bg-neutral-800 text-white font-medium text-sm transition-colors duration-200 flex items-center justify-center gap-2 cursor-pointer">
                <span>Send message</span>
                <Icon class="w-8 h-8" name="outgoing-mail-outline" />
            </button>
        </form>

        <!-- Success Message Container -->
        <div id="successMessage"
            class="hidden mt-4 p-4 bg-emerald-50 border border-emerald-200 text-emerald-800 text-sm">
            Thank you! Your message has been sent.
        </div>
    </div>
</section>

<script>
    function setupForm() {
        const form = document.getElementById('contactForm') as HTMLFormElement | null;
        const successMessage = document.getElementById('successMessage');

        if (!form || !successMessage) return;

        form.addEventListener('submit', (event) => {
            // Prevent standard HTTP form post
            event.preventDefault();

            // Clear the inputs
            form.reset();

            // Show success message locally
            successMessage.classList.remove('hidden');
        });
    }

    setupForm();
    document.addEventListener('astro:after-swap', setupForm);
</script>