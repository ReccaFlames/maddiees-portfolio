---
    import { Icon } from 'astro-icon/components'
    import ImageDance from './ImageDance.astro';
---

<section class="w-full max-w-7xl mx-auto h-[calc(100dvh-88px)] max-h-[850px] min-h-[550px]">
    <div>
        <div class="flex flex-col lg:flex-row">
            <div class="flex flex-col flex-1 justify-center items-center lg:items-start p-8 my-4">
                <h1 class="text-7xl lg:text-5xl text-center lg:text-left">Magdalena Skotnicka</h1>
                <h3 class="text-3xl lg:text-lg mt-4">Mixing dance with visual arts</h3>
            </div>
            <div class="flex flex-col flex-1 px-8 justify-center items-center">
                <ImageDance />
            </div>
        </div>
        <div class="felx flex-row w-fit">
            <a class="flex flex-nowrap justify-center items-center cursor-pointer p-8 text-3xl lg:text-xl" href="#selected-work">Selected work
                <Icon class="w-8 h-8" name="arrow-downwoard-light" />
            </a>
        </div>
    </div>
</section>