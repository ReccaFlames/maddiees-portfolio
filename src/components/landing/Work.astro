---
    import { getCollection } from 'astro:content';
    import { Image } from 'astro:assets';

    const events = await getCollection('events');
---

<section class="w-full max-w-4xl mx-auto px-4 py-12">
    <!-- Carousel Track -->
    <div id="carouselTrack" class="flex gap-6 overflow-x-auto snap-x snap-mandatory scroll-smooth no-scrollbar py-2">
        {
        events.map((entry) => (
        <article
            class="flex-none w-full snap-center flex flex-col md:flex-row overflow-hidden transition-shadow">
            
            <!-- Content Section -->
            <div class="w-full md:w-1/2 p-6 sm:p-8 flex flex-col justify-between">
                <div>
                    <h3 class="text-xl sm:text-2xl font-medium text-neutral-900 leading-snug mb-6">
                        {entry.data.title}
                    </h3>
                    <div class="flex items-center justify-between text-xs text-neutral-500 font-medium mb-4">
                        <span class="px-3 py-1 bg-white border border-neutral-200 rounded-full">{entry.data.tag}</span>
                    </div>
                </div>

                <div class="pt-4 border-t border-neutral-200/60 flex items-center justify-between text-sm sm:text-base">
                    <span class="font-semibold text-neutral-900">{entry.data.date}</span>
                </div>
            </div>

            <!-- Image Section -->
            <div class="w-full md:w-1/2 relative h-56 md:h-auto overflow-hidden">
                <Image src={entry.data.image.url} alt={entry.data.image.alt} width={800} height={500}
                    class="w-full h-full object-cover" loading="eager" />
            </div>
        </article>
        ))
        }
    </div>

    <div class="flex items-end justify-between my-8">
        <!-- Controls -->
        <div class="flex items-center gap-2">
            <button id="prevBtn" aria-label="Previous event"
                class="p-3 border border-neutral-300 hover:bg-neutral-900 hover:text-white hover:border-neutral-900 transition-colors disabled:opacity-30 disabled:pointer-events-none">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5"
                        d="M15.75 19.5L8.25 12l7.5-7.5" />
                </svg>
            </button>
            <button id="nextBtn" aria-label="Next event"
                class="p-3 border border-neutral-300 hover:bg-neutral-900 hover:text-white hover:border-neutral-900 transition-colors disabled:opacity-30 disabled:pointer-events-none">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5"
                        d="M8.25 4.5l7.5 7.5-7.5 7.5" />
                </svg>
            </button>
        </div>
        <div class="flex justify-center w-full">
            <div class="w-fit px-4 py-2 border border-neutral-300 hover:bg-neutral-900 hover:text-white hover:border-neutral-900 transition-colors disabled:opacity-30 disabled:pointer-events-none">
                <a class="cursor-auto">Explore more</a>
            </div>
        </div>
    </div>
</section>

<style>
    .no-scrollbar::-webkit-scrollbar {
        display: none;
    }

    .no-scrollbar {
        -ms-overflow-style: none;
        scrollbar-width: none;
    }
</style>

<script>
    function setupCarousel() {
        const track = document.getElementById("carouselTrack") as HTMLElement | null;
        const prevBtn = document.getElementById("prevBtn") as HTMLButtonElement | null;
        const nextBtn = document.getElementById("nextBtn") as HTMLButtonElement | null;

        if (!track || !prevBtn || !nextBtn) return;

        const getScrollAmount = () => {
            const gap = parseInt(window.getComputedStyle(track).gap) || 24;
            return track.clientWidth + gap;
        };

        prevBtn.addEventListener("click", () => {
            track.scrollBy({ left: -getScrollAmount(), behavior: "smooth" });
        });

        nextBtn.addEventListener("click", () => {
            track.scrollBy({ left: getScrollAmount(), behavior: "smooth" });
        });
    }

    setupCarousel();
    document.addEventListener("astro:after-swap", setupCarousel);
</script>